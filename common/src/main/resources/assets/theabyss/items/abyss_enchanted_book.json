{
  "model": {
    "type": "minecraft:select",
    "property": "theabyss:abyss_book_kind",
    "cases": [
      {
        "when": "armor",
        "model": {
          "type": "minecraft:model",
          "model": "theabyss:item/abyss_book_armor"
        }
      },
      {
        "when": "weapon",
        "model": {
          "type": "minecraft:model",
          "model": "theabyss:item/abyss_book_weapon"
        }
      },
      {
        "when": "bow",
        "model": {
          "type": "minecraft:model",
          "model": "theabyss:item/abyss_book_bow"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "theabyss:item/abyss_book_tool"
    }
  }
}
